# Copie para .env e preencha. O .env nunca vai para o git.

# Corretora: comece SEMPRE na testnet (https://testnet.binance.vision).
BINANCE_REDE=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Infra de desenvolvimento (infra/docker-compose.yml) ---
POSTGRES_USER=zentrade
POSTGRES_PASSWORD=
POSTGRES_DB=zentrade
REDIS_SENHA=
# Chave de cifra das credenciais do n8n: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Banco (packages/banco) ---
DATABASE_URL=postgres://zentrade:TROQUE@127.0.0.1:55432/zentrade
# 32 bytes em base64 que cifram as chaves da corretora e o 2FA: openssl rand -base64 32
# Perder esta chave = perder o acesso às chaves cifradas. Guarde fora do servidor também.
ZENTRADE_CHAVE_MESTRA=

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORTA=8080
REDIS_URL=redis://:TROQUE@127.0.0.1:56379
# Origem da tela: CORS e WebSocket só aceitam esta.
ZENTRADE_ORIGEM_WEB=http://localhost:5173
# Cookies com Secure. Só desligue (false) em desenvolvimento local sem HTTPS.
COOKIE_SEGURO=true
LOG_NIVEL=info
# Quanto tempo uma decisão do modo Sugerir espera aprovação, em minutos.
APROVACAO_VALIDADE_MIN=15
# n8n: o mesmo segredo assina e confere os webhooks nos dois sentidos (>= 32 caracteres: openssl rand -hex 32).
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_SEGREDO=
# Dona do conhecimento que chega pelo n8n. Vazio = a primeira pessoa cadastrada.
N8N_USUARIO_ID=
# Embeddings para o RAG (formato OpenAI; Ollama com bge-m3 ou Voyage, 1024 dimensões). Vazio = notas desligadas.
EMBEDDINGS_URL=
EMBEDDINGS_MODELO=bge-m3
EMBEDDINGS_CHAVE=

# Logs de todos os serviços: trace, debug, info, warn, error.
LOG_LEVEL=info

# Motor (apps/motor). Dinheiro real não liga por aqui: só papel ou testnet.
# papel = ordens simuladas com dados públicos de mercado; testnet = ordens na testnet da Binance (exige as chaves acima).
MOTOR_REDE=papel
# De onde vêm os candles no modo papel (dados públicos, sem chave): testnet ou real.
MOTOR_PAPEL_DADOS=testnet
MOTOR_PAPEL_SALDO=1000
MOTOR_PAPEL_TAXA=0.001
MOTOR_PAPEL_DESLIZAMENTO_BPS=5
# Robôs de desenvolvimento (caminho relativo a apps/motor).
MOTOR_ROBOS_ARQUIVO=robos.exemplo.json
# Candles guardados por robô (50 a 1000).
MOTOR_HISTORICO=500
# true = se o agente falhar, a decisão é barrada (não opera).
MOTOR_AGENTE_OBRIGATORIO=true
# Sem AGENTE_URL, usa um agente fixo: sempre_concorda ou nunca_concorda.
MOTOR_AGENTE_FIXO=nunca_concorda
# Taxa usada para estimar comissões pagas em BNB (fração por ponta).
BINANCE_TAXA_ESTIMADA=0.001
# Onde o motor e a API encontram o agente de IA (ex.: http://localhost:8081). Vazio = agente fixo acima.
AGENTE_URL=

# Embeddings do RAG (packages/conhecimento): "voyage" (pago, precisa de chave) ou "ollama" (local).
EMBEDDINGS_PROVEDOR=voyage
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=bge-m3

# Agente de IA (apps/agente) — POST /analisar na porta 8081, só rede interna.
ANTHROPIC_API_KEY=
# Segredo compartilhado com o motor (>= 32 caracteres). Gere com: openssl rand -hex 32
AGENTE_SEGREDO=
AGENTE_PORTA=8081
AGENTE_HOST=0.0.0.0
AGENTE_MODELO=claude-opus-5
AGENTE_TIMEOUT_MS=55000
# Teto de custo de IA: análises ao mesmo tempo e iniciadas por minuto.
AGENTE_MAX_SIMULTANEAS=4
AGENTE_MAX_POR_MINUTO=30
# Instalação de um usuário só: dono da base de conhecimento quando o pedido não informa.
ZENTRADE_USUARIO_ID=

# CLI `zentrade` e servidor MCP: falam com a API usando um token criado na tela.
ZENTRADE_API_URL=http://localhost:8080
ZENTRADE_TOKEN=
