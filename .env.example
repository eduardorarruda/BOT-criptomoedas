# Copie para .env e preencha. O .env nunca vai para o git.
# Variável vazia conta como ausente (vale o padrão do serviço).
# Segredos: gere com `openssl rand -hex 32` (os que entram em URL, como as senhas do
# banco e do Redis, precisam ser só letras e números: use -hex).

# --- Logs de todos os serviços (api, motor, agente): trace, debug, info, warn, error ---
LOG_LEVEL=info

# --- Infra (infra/docker-compose.yml) ---
POSTGRES_USER=zentrade
POSTGRES_PASSWORD=
POSTGRES_DB=zentrade
REDIS_SENHA=
# Chave de cifra das credenciais do n8n: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Para os fluxos do n8n (infra/n8n/README.md). Tokens do bot ficam nas credenciais do n8n.
TELEGRAM_CHAT_ID=
TELEGRAM_APROVADORES_IDS=
ZENTRADE_FEEDS_RSS=
ZENTRADE_ALERTA_EMAIL=
ZENTRADE_ALERTA_EMAIL_DE=

# --- Banco (packages/banco; usado pela API, pelo agente e pelas migrações) ---
DATABASE_URL=postgres://zentrade:TROQUE@127.0.0.1:55432/zentrade
# 32 bytes em base64 que cifram as chaves da corretora e o 2FA: openssl rand -base64 32
# Perder esta chave = perder o acesso às chaves cifradas. Guarde fora do servidor também.
ZENTRADE_CHAVE_MESTRA=

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORTA=8080
REDIS_URL=redis://:TROQUE@127.0.0.1:56379
# Origem da tela: CORS e WebSocket só aceitam esta (pnpm dev usa o Vite na 5173).
ZENTRADE_ORIGEM_WEB=http://localhost:5173
# Cookies com Secure. Navegadores aceitam Secure em http://localhost; só desligue (false)
# se acessar por outro nome sem HTTPS, e nunca em produção.
COOKIE_SEGURO=true
# Quanto tempo uma decisão do modo Sugerir espera aprovação, em minutos (1 a 1440).
APROVACAO_VALIDADE_MIN=15
# De quantos em quantos minutos a API importa a carteira da Binance de cada pessoa (0 = só pelo botão).
CARTEIRA_SINCRONIZAR_MIN=30
# De quantos em quantos minutos a API confere a posição dos robôs com o saldo da Binance (0 = só pelo botão).
RECONCILIACAO_MIN=10
# n8n: o mesmo segredo assina e confere os webhooks nos dois sentidos (>= 32 caracteres).
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_SEGREDO=
# Dona do conhecimento que chega pelo n8n (UUID da pessoa). Obrigatório quando houver
# mais de uma pessoa cadastrada; com uma só, vazio = ela.
N8N_USUARIO_ID=
# Onde a API e o motor encontram o agente de IA (ex.: http://localhost:8081).
# Na API serve para a saúde e para o assistente (que também usa AGENTE_SEGREDO, abaixo);
# no motor, vazio = agente fixo (MOTOR_AGENTE_FIXO).
AGENTE_URL=
# Opcional: cotações de FIIs pela brapi.dev (token do painel deles). Vazio = preço
# informado à mão na tela do imobiliário.
BRAPI_TOKEN=

# --- Renda fixa: Pluggy (conectar bancos; opcional) ---
# Credenciais da aplicação no painel da Pluggy (dashboard.pluggy.ai → Applications), uma
# por instalação; as conexões ficam por pessoa. Vazias = integração desligada (o cadastro
# manual e os índices do Banco Central funcionam sem elas). O segredo nunca vai para a tela.
# Atenção ao MeuPluggy (gratuito, uso pessoal): só dá para conectar bancos nos 15 dias de
# teste da conta de desenvolvedor. Não apague a conexão na Pluggy depois disso.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Embeddings do RAG (packages/conhecimento; os mesmos para a API e o agente) ---
# "voyage" (pago, precisa de chave) ou "ollama" (local, com bge-m3). Sem chave da
# Voyage, a API sobe com o conhecimento desligado e explica o motivo.
EMBEDDINGS_PROVEDOR=voyage
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=bge-m3

# --- Motor (apps/motor). Dinheiro real não liga por aqui: só papel ou testnet. ---
# papel = ordens simuladas com dados públicos de mercado; testnet = ordens na testnet
# da Binance (exige BINANCE_API_KEY/SECRET). Comece SEMPRE no papel ou na testnet.
MOTOR_REDE=papel
# De onde vêm os candles no modo papel (dados públicos, sem chave): testnet ou real.
MOTOR_PAPEL_DADOS=testnet
MOTOR_PAPEL_SALDO=1000
MOTOR_PAPEL_TAXA=0.001
MOTOR_PAPEL_DESLIZAMENTO_BPS=5
# Robôs de desenvolvimento (caminho relativo a apps/motor).
MOTOR_ROBOS_ARQUIVO=robos.exemplo.json
# Candles guardados por robô (50 a 1000).
MOTOR_HISTORICO=500
# WebSocket de candles fora por mais que isto (minutos) vira alerta (docs/alertas.md).
MOTOR_ALERTA_WEBSOCKET_MIN=5
# true = se o agente falhar, a decisão é barrada (não opera).
MOTOR_AGENTE_OBRIGATORIO=true
# Sem AGENTE_URL, usa um agente fixo: sempre_concorda ou nunca_concorda.
MOTOR_AGENTE_FIXO=nunca_concorda
# Na testnet, cada robô usa a chave que a pessoa cadastrou na tela (cifrada no banco):
# o motor precisa da MESMA ZENTRADE_CHAVE_MESTRA da API (acima) para decifrá-la.
# desenvolvimento libera as chaves abaixo para quem não cadastrou a própria; producao (padrão) não.
ZENTRADE_AMBIENTE=producao
# Só com ZENTRADE_AMBIENTE=desenvolvimento (https://testnet.binance.vision).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Taxa usada para estimar comissões pagas em BNB (fração por ponta).
BINANCE_TAXA_ESTIMADA=0.001

# --- Agente de IA (apps/agente): POST /analisar e o assistente na porta 8081, só rede interna ---
# Opcional: sem a chave, o provedor "api" fica indisponível e só o Claude Code atende.
ANTHROPIC_API_KEY=
# Segredo compartilhado com o motor e a API (>= 32 caracteres): openssl rand -hex 32
AGENTE_SEGREDO=
AGENTE_PORTA=8081
AGENTE_HOST=0.0.0.0
AGENTE_MODELO=claude-opus-5
AGENTE_TIMEOUT_MS=55000
# Teto de custo de IA: análises ao mesmo tempo e iniciadas por minuto.
AGENTE_MAX_SIMULTANEAS=4
AGENTE_MAX_POR_MINUTO=30
# Instalação de um usuário só: dono da base de conhecimento quando o pedido não informa.
ZENTRADE_USUARIO_ID=
# Claude Code (provedor "cli", o plano da pessoa; veja docs/operacao.md). Executável e
# contas: id=/pasta-de-login (CLAUDE_CONFIG_DIR), separadas por vírgula. Vazio = o login
# padrão (~/.claude) de quem roda o agente. No Docker: principal=/dados/claude/principal.
AGENTE_CLAUDE_CAMINHO=claude
AGENTE_CLAUDE_CONTAS=
# Tetos de cada execução do Claude Code: voltas com as ferramentas e custo em US$.
AGENTE_CLI_MAX_TURNOS=8
AGENTE_CLI_TETO_USD=1
# Assistente (chat): prazo de uma resposta e respostas ao mesmo tempo / por minuto.
AGENTE_CHAT_TIMEOUT_MS=300000
AGENTE_CHAT_MAX_SIMULTANEAS=4
AGENTE_CHAT_MAX_POR_MINUTO=20
# O agente usa REDIS_URL (acima) para publicar os passos ao vivo das análises.

# --- CLI `zentrade` e servidor MCP: falam com a API usando um token criado na tela ---
ZENTRADE_API_URL=http://localhost:8080
ZENTRADE_TOKEN=

# --- Só para o perfil "app" do docker-compose (tudo em containers) ---
# Portas no host (sempre em 127.0.0.1). A tela fica em http://localhost:WEB_PORTA_HOST.
BANCO_PORTA_HOST=55432
REDIS_PORTA_HOST=56379
N8N_PORTA_HOST=5678
API_PORTA_HOST=8080
WEB_PORTA_HOST=8088
# Onde o n8n (em container) acha a API. Vazio = http://host.docker.internal:8080 (API
# rodando no host com pnpm dev). Com o perfil app, use http://api:8080.
ZENTRADE_API_URL_PARA_N8N=
# Origem da tela no Docker (padrão: http://localhost:WEB_PORTA_HOST).
ZENTRADE_ORIGEM_WEB_DOCKER=
# Agente do motor no Docker: vazio = agente fixo; http://agente:8081 = IA de verdade.
MOTOR_AGENTE_URL=
# Ollama rodando no host, visto de dentro dos containers.
OLLAMA_URL_DOCKER=http://host.docker.internal:11434
# Prefixo dos nomes das imagens construídas (zentrade-api:local, ...).
ZENTRADE_IMAGEM=zentrade
