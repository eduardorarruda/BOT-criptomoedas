# Copie para .env e preencha. O .env nunca vai para o git.

# Corretora: comece SEMPRE na testnet (https://testnet.binance.vision).
BINANCE_REDE=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Embeddings do RAG (packages/conhecimento): "voyage" (pago, precisa de chave) ou "ollama" (local).
EMBEDDINGS_PROVEDOR=voyage
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=bge-m3
