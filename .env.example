# Copie para .env e preencha. O .env nunca vai para o git.

# Corretora: comece SEMPRE na testnet (https://testnet.binance.vision).
BINANCE_REDE=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Logs de todos os serviços: trace, debug, info, warn, error.
LOG_LEVEL=info

# Motor (apps/motor). Dinheiro real não liga por aqui: só papel ou testnet.
# papel = ordens simuladas com dados públicos de mercado; testnet = ordens na testnet da Binance (exige as chaves acima).
MOTOR_REDE=papel
# De onde vêm os candles no modo papel (dados públicos, sem chave): testnet ou real.
MOTOR_PAPEL_DADOS=testnet
MOTOR_PAPEL_SALDO=1000
MOTOR_PAPEL_TAXA=0.001
MOTOR_PAPEL_DESLIZAMENTO_BPS=5
# Robôs de desenvolvimento (caminho relativo a apps/motor).
MOTOR_ROBOS_ARQUIVO=robos.exemplo.json
# Candles guardados por robô (50 a 1000).
MOTOR_HISTORICO=500
# true = se o agente falhar, a decisão é barrada (não opera).
MOTOR_AGENTE_OBRIGATORIO=true
# Sem AGENTE_URL, usa um agente fixo: sempre_concorda ou nunca_concorda.
MOTOR_AGENTE_FIXO=nunca_concorda
# Taxa usada para estimar comissões pagas em BNB (fração por ponta).
BINANCE_TAXA_ESTIMADA=0.001
# Onde o motor encontra o agente de IA (ex.: http://localhost:8081). Vazio = agente fixo acima.
AGENTE_URL=

# Embeddings do RAG (packages/conhecimento): "voyage" (pago, precisa de chave) ou "ollama" (local).
EMBEDDINGS_PROVEDOR=voyage
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=bge-m3

# Agente de IA (apps/agente) — POST /analisar na porta 8081, só rede interna.
ANTHROPIC_API_KEY=
# Segredo compartilhado com o motor (>= 32 caracteres). Gere com: openssl rand -hex 32
AGENTE_SEGREDO=
AGENTE_PORTA=8081
AGENTE_HOST=0.0.0.0
AGENTE_MODELO=claude-opus-5
AGENTE_TIMEOUT_MS=55000
# Teto de custo de IA: análises ao mesmo tempo e iniciadas por minuto.
AGENTE_MAX_SIMULTANEAS=4
AGENTE_MAX_POR_MINUTO=30
# Banco com as tabelas do RAG e de decisões.
DATABASE_URL=postgres://zentrade:troque-esta-senha@localhost:55432/zentrade
# Instalação de um usuário só: dono da base de conhecimento quando o pedido não informa.
ZENTRADE_USUARIO_ID=

# CLI `zentrade` e servidor MCP: falam com a API usando um token criado na tela.
ZENTRADE_API_URL=http://localhost:8080
ZENTRADE_TOKEN=
