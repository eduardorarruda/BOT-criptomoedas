# Copie para .env e preencha. O .env nunca vai para o git.

# Corretora: comece SEMPRE na testnet (https://testnet.binance.vision).
BINANCE_REDE=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Infra de desenvolvimento (infra/docker-compose.yml) ---
POSTGRES_USER=zentrade
POSTGRES_PASSWORD=
POSTGRES_DB=zentrade
REDIS_SENHA=
# Chave de cifra das credenciais do n8n: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Banco (packages/banco) ---
DATABASE_URL=postgres://zentrade:TROQUE@127.0.0.1:55432/zentrade
# 32 bytes em base64 que cifram as chaves da corretora e o 2FA: openssl rand -base64 32
# Perder esta chave = perder o acesso às chaves cifradas. Guarde fora do servidor também.
ZENTRADE_CHAVE_MESTRA=

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORTA=8080
REDIS_URL=redis://:TROQUE@127.0.0.1:56379
# Origem da tela: CORS e WebSocket só aceitam esta.
ZENTRADE_ORIGEM_WEB=http://localhost:5173
# Cookies com Secure. Só desligue (false) em desenvolvimento local sem HTTPS.
COOKIE_SEGURO=true
LOG_NIVEL=info
# Quanto tempo uma decisão do modo Sugerir espera aprovação, em minutos.
APROVACAO_VALIDADE_MIN=15
# n8n: o mesmo segredo assina e confere os webhooks nos dois sentidos (>= 32 caracteres: openssl rand -hex 32).
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_SEGREDO=
# Dona do conhecimento que chega pelo n8n. Vazio = a primeira pessoa cadastrada.
N8N_USUARIO_ID=
# Opcional: checagem de saúde do agente (GET $AGENTE_URL/saude).
AGENTE_URL=
# Embeddings para o RAG (formato OpenAI; Ollama com bge-m3 ou Voyage, 1024 dimensões). Vazio = notas desligadas.
EMBEDDINGS_URL=
EMBEDDINGS_MODELO=bge-m3
EMBEDDINGS_CHAVE=
