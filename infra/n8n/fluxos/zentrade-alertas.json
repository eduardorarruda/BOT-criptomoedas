            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8c684c35-069f-4b5c-a499-cfd70d252ef9",
              "leftValue": "={{ $json.valida }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d2341797-3834-4161-a6a0-e3c5a24affb0",
      "name": "Assinatura válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"erro\": {\n    \"codigo\": \"assinatura_invalida\",\n    \"mensagem\": \"Assinatura ausente, inválida ou vencida.\"\n  }\n}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "ab27e417-4398-4b1e-ab59-a8b52961ed8e",
      "name": "Recusar (401)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// Valida o alerta ({ tipo, titulo, mensagem, em }) e monta o texto para o Telegram.\nconst LIMITE_TELEGRAM = 4000;\nconst escaparHtml = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst a = $input.first().json.dados;\nconst texto = (v, min, max) => typeof v === 'string' && v.length >= min && v.length <= max;\n\nconst problemas = [];\nif (!a || typeof a !== 'object' || Array.isArray(a)) {\n  problemas.push('o corpo precisa ser um objeto');\n} else {\n  if (!texto(a.tipo, 1, 40)) problemas.push('tipo');\n  if (!texto(a.titulo, 1, 200)) problemas.push('titulo');\n  if (!texto(a.mensagem, 0, 4000)) problemas.push('mensagem');\n  if (!Number.isSafeInteger(a.em) || a.em < 0) problemas.push('em');\n}\nif (problemas.length > 0) {\n  return [{ json: { ok: false, motivo: `campos inválidos: ${problemas.join(', ')}` } }];\n}\n\nconst quando = new Date(a.em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst completo = `ZenTrade: ${a.titulo}\\n\\n${a.mensagem}\\n\\n${a.tipo} · ${quando}`;\nconst textoFinal =\n  completo.length <= LIMITE_TELEGRAM ? completo : `${completo.slice(0, LIMITE_TELEGRAM - 1)}…`;\n\nreturn [\n  {\n    json: {\n      ok: true,\n      assunto: `[ZenTrade] ${a.titulo}`,\n      texto: textoFinal,\n      textoTelegram: escaparHtml(textoFinal),\n    },\n  },\n];"
      },
