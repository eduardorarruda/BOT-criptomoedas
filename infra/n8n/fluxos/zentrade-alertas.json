      "id": "a3995f15-e0e1-4beb-a9d4-bcf2203717ce",
      "name": "Ler corpo bruto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Confere o cabeçalho X-ZenTrade-Assinatura e o prazo, exatamente como verificar()\n// de @zentrade/contratos. O HMAC em si sai do nó Crypto seguinte, que guarda o\n// segredo numa credencial do n8n (nunca no fluxo).\nconst TOLERANCIA_SEGUNDOS = 300;\n\nconst item = $input.first().json;\nconst corpo = typeof item.corpoBruto === 'string' ? item.corpoBruto : '';\nconst cabecalho = (item.headers || {})['x-zentrade-assinatura'];\nconst agoraSegundos = Math.floor(Date.now() / 1000);\n\nlet formatoOk = false;\nlet prazoOk = false;\nlet recebida = '';\nlet mensagem = '';\nif (cabecalho) {\n  const partes = Object.fromEntries(String(cabecalho).split(',').map((p) => p.split('=', 2)));\n  const t = Number(partes.t);\n  recebida = typeof partes.v1 === 'string' ? partes.v1 : '';\n  formatoOk = Number.isInteger(t) && /^[0-9a-f]{64}$/.test(recebida);\n  if (formatoOk) {\n    prazoOk = Math.abs(agoraSegundos - t) <= TOLERANCIA_SEGUNDOS;\n    mensagem = `${t}.${corpo}`;\n  }\n}\n\nreturn [{ json: { corpo, recebida, formatoOk, prazoOk, mensagem } }];"
      },
      "id": "1e5d547f-098a-4837-a0d5-53da7eb24e3b",
      "name": "Preparar verificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.mensagem }}",
        "dataPropertyName": "esperada",
        "encoding": "hex"
      },
      "id": "c4ae2af5-0699-498d-ad1a-a7c3daa73317",
      "name": "Calcular HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "crypto": {
          "id": "ztCredHmac000001",
          "name": "ZenTrade assinatura dos webhooks"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Compara o HMAC esperado (nó Crypto) com o recebido em tempo constante e só então\n// interpreta o corpo. Corpo sem assinatura válida nunca é lido.\nconst item = $input.first().json;\n\nconst iguais = (a, b) => {\n  if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;\n  let diferenca = 0;\n  for (let i = 0; i < a.length; i++) diferenca |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return diferenca === 0;\n};\n\nconst valida = item.formatoOk === true && item.prazoOk === true && iguais(item.esperada, item.recebida);\nlet dados = null;\nif (valida) {\n  try {\n    dados = JSON.parse(item.corpo);\n  } catch {\n    dados = null;\n  }\n}\n\nreturn [{ json: { valida, dados } }];"
      },
      "id": "9c0138b7-9a73-4e45-a6c8-c87d6cf0e407",
      "name": "Conferir assinatura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
