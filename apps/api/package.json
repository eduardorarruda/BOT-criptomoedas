{
  "name": "@zentrade/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do ZenTrade: REST e WebSocket para a tela, CLI e MCP; recebe os webhooks do n8n.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integracao": "vitest run --coverage --config vitest.integracao.config.ts",
    "iniciar": "node --env-file-if-exists=../../.env dist/servidor.js",
    "criar-usuario": "node --env-file-if-exists=../../.env dist/comandos/criar-usuario.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@zentrade/banco": "workspace:*",
    "@zentrade/conhecimento": "workspace:*",
    "@zentrade/contratos": "workspace:*",
    "@zentrade/dominio": "workspace:*",
    "bullmq": "^6.3.12",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  }
}
